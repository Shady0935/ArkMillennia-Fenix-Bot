# Discord bot
DISCORD_TOKEN=replace-with-bot-token
DISCORD_GUILD_ID=
DISCORD_ADMIN_ROLE_IDS=
DISCORD_GLOBAL_COMMANDS=false
DISCORD_STATUS=ArkMillennia Fenix

# MySQL database
DB_HOST=
DB_PORT=3306
DB_NAME=
DB_USER=
DB_PASSWORD=replace-with-database-password

# Dashboard
DASHBOARD_ENABLED=true
DASHBOARD_HOST=0.0.0.0
DASHBOARD_PORT=24400
DASHBOARD_PUBLIC_URL=https://bot-dashboard.milleniafenix.online
# One or more Discord role IDs allowed into the dashboard; separate with commas.
DASHBOARD_REQUIRED_ROLE_IDS=
DASHBOARD_ADMIN_ROLE_IDS=
DASHBOARD_SESSION_DAYS=30
DASHBOARD_TRUST_PROXY_HOPS=1
DISCORD_OAUTH_CLIENT_ID=
DISCORD_OAUTH_CLIENT_SECRET=replace-with-oauth-client-secret

# Announcements consent source (initial defaults; dashboard changes are stored in MySQL)
ANNOUNCEMENTS_CHANNEL_ID=
ANNOUNCEMENTS_MESSAGE_ID=
ANNOUNCEMENTS_EMOJI=✅
ANNOUNCEMENTS_ADMIN_ROLE_ID=

# Optional modules
BOT_DISABLED_JS_MODULES=
LAUNCHER_STAFF_ROLE_IDS=

# ARKMillennia Fenix modules
ARK_RANKING_CHANNEL_ID=
ARK_RANKING_DATA_FILE=ranking.json
ARK_SHOP_CHANNEL_ID=
ARK_TICKET_CHANNEL_ID=
ARK_TICKET_URL=
ARK_STATUS_CHANNEL_ID=
ARK_STATUS_POLL_SECONDS=60
# Entries: Name|public_host|Steam_query_port|mode, separated by semicolons
ARK_STATUS_MAPS=
ARK_MODE_ANNOUNCEMENTS_CHANNEL_ID=
ARK_MODE_SCHEDULE_FILE=mode-schedule.json
ARK_MODE_SCHEDULE_POLL_SECONDS=30
# Audit delivery stays disabled until a private channel and admin role access are configured
ARK_ADMIN_AUDIT_ENABLED=false
ARK_ADMIN_AUDIT_CHANNEL_ID=
ARK_AUDIT_DIRECTORY=admin-audit

# Millennia Bridge (ARK <-> Discord chat relay). Servers and token hashes live in data/bridge/servers.json
BRIDGE_ENABLED=false
BRIDGE_HOST=127.0.0.1
BRIDGE_PORT=24410
BRIDGE_PATH=/bridge
# Off loopback, TLS is mandatory: terminate it here (cert/key files) or declare a TLS reverse proxy in front
BRIDGE_TLS_CERT_FILE=
BRIDGE_TLS_KEY_FILE=
BRIDGE_BEHIND_TLS_PROXY=false
BRIDGE_TRUST_PROXY_HOPS=0
BRIDGE_SERVERS_FILE=servers.json
BRIDGE_DISCORD_CHANNEL_IDS=
BRIDGE_ARK_TO_DISCORD=true
BRIDGE_DISCORD_TO_ARK=true
BRIDGE_CROSS_SERVER=true
BRIDGE_DISCORD_LABEL=Discord
BRIDGE_DISCORD_FORMAT=[{label}] {author}: {text}
BRIDGE_MAX_MESSAGE_CHARS=256
BRIDGE_LOG_LEVEL=info
